# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Required for the google_dork module (SerpAPI).
SERPAPI_KEY=

# Optional. CourtListener works without a token; a token gives higher rate limits.
COURTLISTENER_TOKEN=

# Optional. Maximum google_dork queries per run (default 20).
# DREDGE_MAX_QUERIES=20
